<%- include('partials/head') %><main id="main" class="wrap section"><div class="breadcrumbs"><a href="/">Home</a> / <a href="/cakes">Cakes</a> / <%= cake.name %></div><div class="product-layout"><div class="product-gallery"><img id="product-main" class="product-main" src="<%= imageUrl(cake.image) %>" alt="<%= cake.name %>"><div class="thumbnails"><% [cake.image,...cake.gallery].forEach((img,i)=>{ %><button data-photo="<%= imageUrl(img) %>" aria-label="View photo <%= i+1 %>"><img src="<%= imageUrl(img) %>" alt=""></button><% }) %></div></div><div class="product-detail"><p class="eyebrow"><%= cake.category %> · _BAKING_CO</p><h1><%= cake.name %></h1><p class="product-description"><%= cake.description %></p><form id="product-form" data-cake="<%= cake.id %>"><p id="product-price" class="large-price"><%= money(priceOf(cake,cake.variants[0])) %></p><% if(cake.offerText&&cake.variants.some(v=>hasOffer(cake,v))){ %><p class="offer-note"><%= cake.offerText %><%= cake.offerEnds?' · Until '+cake.offerEnds:'' %></p><% } %><fieldset><legend>Choose your size</legend><div class="option-pills"><% cake.variants.forEach((v,i)=>{ %><label><input type="radio" name="variantId" value="<%= v.id %>" <%= i===0?'checked':'' %> required><span><%= v.label %></span></label><% }) %></div></fieldset><div class="form-grid"><label>Flavour<select name="flavour"><% cake.flavours.forEach(f=>{ %><option><%= f %></option><% }) %></select></label><label>Egg preference<select name="egg"><% cake.eggOptions.forEach(f=>{ %><option><%= f %></option><% }) %></select></label></div><label>Message on the cake <small>(optional)</small><input name="message" maxlength="80" placeholder="e.g. Happy Birthday, Simran!"></label><div class="purchase-row"><label>Quantity<input name="quantity" type="number" value="1" min="1" max="20" required></label><button class="button dark" <%= !cake.available?'disabled':'' %>><%= cake.available?'Add to my bag →':'Currently unavailable' %></button></div><p class="form-note"><%= cake.minNoticeDays?cake.minNoticeDays+' day(s) advance notice. ':'' %>Final design, delivery and availability are confirmed with the baker.</p></form><details open><summary>The lovely details</summary><p><%= cake.ingredients||'Ask us about ingredients for your chosen flavour.' %></p></details><details><summary>Allergies & dietary requests</summary><p><%= cake.allergens||'Please discuss all allergies with us before ordering.' %></p></details><details><summary>Delivery & collection</summary><p><%= site.deliveryText %></p></details></div></div><section class="section"><div class="section-heading"><h2>More to fall in love with</h2></div><div class="cake-grid"><% cakes.filter(c=>c.id!==cake.id).slice(0,4).forEach(cake=>{ %><%- include('partials/card',{cake}) %><% }) %></div></section></main><%- include('partials/footer') %>
