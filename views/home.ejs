<%- include('partials/head') %><main id="main">
<section class="category-strip wrap" aria-label="Cake categories"><% const categories=[...new Set(cakes.map(c=>c.category))];categories.forEach(category=>{const c=cakes.find(x=>x.category===category); %><a class="circle-link" href="/cakes?category=<%= encodeURIComponent(category) %>"><img src="<%= imageUrl(c.image) %>" alt="" width="100" height="100"><span><%= category %></span></a><% }) %><a class="circle-link circle-text" href="/custom"><div>YOUR<br>DESIGN</div><span>Custom Cakes</span></a><a class="circle-link circle-text" href="/cakes?offers=1"><div class="coral-circle">SWEET<br>DEALS</div><span>Special Offers</span></a></section>
<section class="hero"><img class="hero-image" src="<%= imageUrl(site.heroImage) %>" alt="Celebration cakes in a festive setting" fetchpriority="high" width="1536" height="1024"><div class="hero-shade"></div><div class="hero-content wrap"><p class="eyebrow">CELEBRATIONS, WITH A PERSONAL TOUCH</p><h1><%= site.heroTitle %></h1><p><%= site.heroDescription %></p><a class="button coral" href="/cakes"><%= site.heroButton %> <span>↗</span></a></div><% if(site.heroImageSample){ %><span class="hero-caption">Illustrative banner · explore our actual cakes below</span><% } %></section>
<section class="section wrap"><div class="section-heading"><p class="eyebrow">THE CELEBRATION COLLECTION</p><h2>Find your happy slice</h2><p>A little something for every lovely moment.</p></div><div class="cake-grid"><% [...cakes].sort((a,b)=>Number(b.featured)-Number(a.featured)).slice(0,4).forEach(cake=>{ %><%- include('partials/card',{cake}) %><% }) %><% if(cakes.length<4){ %><a class="custom-card" href="/custom"><span class="line-cake">✧</span><small>HAVE SOMETHING IN MIND?</small><h3>Let’s make it<br>yours.</h3><span class="button outline">Design my cake ↗</span></a><% } %></div><div class="center section-end"><a href="/cakes" class="text-link">Explore all cakes →</a></div></section>
<section class="section soft"><div class="wrap"><div class="section-heading"><p class="eyebrow">PICK YOUR FAVOURITE</p><h2>Sweet indulgence</h2><p>Your flavour. Your celebration.</p></div><div class="flavour-row"><% const flavours=[...new Set(cakes.flatMap(c=>c.flavours))];flavours.forEach((flavour,i)=>{const c=cakes.find(x=>x.flavours.includes(flavour)); %><a class="flavour-card" href="/cakes?flavour=<%= encodeURIComponent(flavour) %>"><img src="<%= imageUrl(c.image) %>" alt="" loading="lazy"><span><%= flavour %> →</span></a><% }) %><a class="flavour-card flavour-note" href="/custom"><span class="sparkle">✳</span><strong>Dreaming of another flavour?</strong><span>Tell us what you love →</span></a></div></div></section>
<section class="section wrap"><div class="section-heading"><p class="eyebrow">MOMENTS WORTH CELEBRATING</p><h2>Every occasion, a little sweeter</h2></div><div class="occasion-grid"><% [['Birthday','Birthday wishes'],['Anniversary','Another year of love'],['Wedding','The sweetest beginning'],['Just because','No occasion needed']].forEach(([label,subtitle],i)=>{const c=cakes.find(x=>x.category===label)||cakes[i%cakes.length]; %><a class="occasion" href="<%= categories.includes(label)?'/cakes?category='+encodeURIComponent(label):'/custom?occasion='+encodeURIComponent(label) %>"><% if(c){ %><img src="<%= imageUrl(c.image) %>" alt="" loading="lazy"><% } %><div><small><%= subtitle %></small><h3><%= label %> <span>↗</span></h3></div></a><% }) %></div></section>
<div class="marquee" aria-label="Made for your moments"><span>BAKED FOR YOUR HAPPY MOMENTS</span><b>✳</b><span>A LITTLE SLICE OF LOVE</span><b>✳</b><span>MAKE IT PERSONAL</span></div>
<section class="section wrap two-panels"><div class="style-panel"><p class="eyebrow">MAKE AN ENTRANCE</p><h2>Cakes in vogue</h2><p>A showstopper for your celebration.</p><div class="mini-image-grid"><% ['Vintage','Floral','Theme'].forEach((style,i)=>{ %><a href="/custom?occasion=<%= style %>"><% if(cakes.length){ %><img src="<%= imageUrl(cakes[i%cakes.length].image) %>" alt="" loading="lazy"><% } %><span><%= style %> ↗</span></a><% }) %></div></div><div class="style-panel peach"><p class="eyebrow">A CAKE AS UNIQUE AS YOU</p><h2>What’s your type?</h2><p>Bring your favourite idea to the table.</p><div class="pill-grid"><% ['Photo cake','Minimal & elegant','Two-tier cake','Character cake','Heart cake','Something new'].forEach(style=>{ %><a href="/custom?occasion=<%= encodeURIComponent(style) %>"><%= style %> ↗</a><% }) %></div></div></section>
<section class="promo wrap"><div class="promo-image"><img src="<%= imageUrl(site.promoImage) %>" alt="A personalised cake by _baking_co" loading="lazy"></div><div class="promo-copy"><p class="eyebrow">THOUGHTFULLY PERSONALISED</p><h2><%= site.promoTitle %></h2><p><%= site.promoText %></p><a class="button dark" href="/custom">Let’s create something lovely ↗</a></div></section>
<section class="section wrap"><div class="section-heading"><p class="eyebrow">FROM OUR CAKE DIARY</p><h2>A closer look at the sweetness</h2><p>Follow the details, designs and celebrations on Instagram.</p></div><div class="reel-grid"><% if(site.reels?.length){site.reels.forEach(reel=>{ %><a class="reel" href="<%= reel.url %>" target="_blank" rel="noopener"><img src="<%= imageUrl(reel.image) %>" alt="<%= reel.title %>" loading="lazy"><span>▶ <%= reel.title %></span></a><% })}else{cakes.slice(0,3).forEach(c=>{ %><a class="reel" href="<%= site.instagram %>" target="_blank" rel="noopener"><img src="<%= imageUrl(c.image) %>" alt="<%= c.name %> by _baking_co" loading="lazy"><span>See our cake stories ↗</span></a><% })} %></div></section>
<section class="age-band"><div class="wrap"><div><p class="eyebrow">EVERY YEAR IS A MILESTONE</p><h2>Big wishes.<br>Beautiful birthdays.</h2></div><div class="age-links"><% ['1st','18th','21st','30th','50th','Any age'].forEach(age=>{ %><a href="/custom?occasion=<%= encodeURIComponent(age+' birthday') %>"><strong><%= age %></strong><span>Celebrate ↗</span></a><% }) %></div></div></section>
<section class="section blush"><div class="wrap"><div class="section-heading"><h2>Little gathering or grand celebration?</h2><p>Find the right size for your happy crowd.</p></div><div class="weight-links"><% [...new Set(cakes.flatMap(c=>c.variants.map(v=>v.label)))].forEach(weight=>{ %><a href="/cakes?weight=<%= encodeURIComponent(weight) %>"><span class="weight-icon">♧</span><strong><%= weight %></strong><span>Explore →</span></a><% }) %><a href="/custom"><span class="weight-icon">✧</span><strong>Custom size</strong><span>Ask us →</span></a></div></div></section>
<section class="section wrap two-panels"><div class="small-promo"><p class="eyebrow">CELEBRATION COMING UP?</p><h2>Let’s make a plan.</h2><p>Tell us your date. We’ll confirm what’s possible.</p><a class="button dark" href="/custom">Check availability ↗</a></div><div class="small-promo peach"><p class="eyebrow">SHAPE YOUR CELEBRATION</p><h2>Round. Heart. Your idea.</h2><p>A personal touch, right down to the shape.</p><a class="button outline" href="/custom?occasion=Custom%20shape">Explore a custom design ↗</a></div></section>
<section class="section wrap budget-section"><div class="section-heading"><h2>Sweet finds, your budget</h2></div><div class="budget-links"><% [500,1000,2000].forEach(budget=>{ %><a href="/cakes?budget=<%= budget %>"><small>CAKES UNDER</small><strong>₹<%= budget.toLocaleString('en-IN') %></strong><span>Explore the collection →</span></a><% }) %></div></section>
<section class="section blush"><div class="wrap"><div class="section-heading"><h2>More ways to make it memorable</h2></div><div class="three-links"><a href="/custom?occasion=Gift%20cake">A thoughtful gift <span>↗</span></a><a href="/corporate">For your whole team <span>↗</span></a><a href="/custom?occasion=Celebration%20table">A celebration table <span>↗</span></a></div></div></section>
<% if(site.reviews?.length){ %><section class="section wrap"><div class="section-heading"><h2>Sweet words from you</h2></div><div class="review-grid"><% site.reviews.forEach(review=>{ %><blockquote><p>“<%= review.text %>”</p><cite><%= review.name %></cite></blockquote><% }) %></div></section><% } %>
<section class="section wrap"><div class="section-heading"><h2>A little more personal</h2></div><div class="why-grid"><div><span>01</span><h3>Made for your moment</h3><p>Share the name, theme and details that make your celebration yours.</p></div><div><span>02</span><h3>A conversation away</h3><p>Your enquiry reaches us before you continue the conversation on WhatsApp.</p></div><div><span>03</span><h3>Clear before you confirm</h3><p>Discuss the design, delivery, ingredients and final price with us.</p></div></div></section>
<section class="seo wrap"><details><summary>Celebration cakes by _baking_co <span>+</span></summary><p><%= site.about %></p><p><%= site.deliveryText %></p></details></section>
</main><%- include('partials/footer') %>
