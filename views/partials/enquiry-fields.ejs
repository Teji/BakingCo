<div class="form-grid"><label>Your name<input name="name" autocomplete="name" minlength="2" maxlength="100" required></label><label>Phone number<input name="phone" type="tel" autocomplete="tel" pattern="[+0-9 ()-]{10,20}" maxlength="20" required></label><label>Celebration date<input name="date" type="date" required></label><label>How would you like it?<select name="fulfilment"><option>Delivery</option><option>Pickup</option></select></label><label>City / area<select name="area"><option value="">Choose your area</option><% site.deliveryAreas.forEach(area=>{ %><option><%= area %></option><% }) %></select></label><label class="span-2">Delivery address <small>(required for delivery)</small><textarea name="locality" autocomplete="street-address" maxlength="400" rows="2"></textarea></label><label class="span-2">Anything else? <small>(allergies, timing or special requests)</small><textarea name="notes" maxlength="1000" rows="3"></textarea></label></div><label class="honey" aria-hidden="true">Leave this empty<input name="website" tabindex="-1" autocomplete="off"></label><label class="consent"><input type="checkbox" required> I agree to the <a href="/policies/terms">ordering terms</a> and <a href="/policies/privacy">privacy policy</a>.</label><p class="form-note"><%= site.orderNotice %></p><button class="button dark wide" type="submit">Save enquiry & continue →</button><p class="form-status" role="status" aria-live="polite"></p>
