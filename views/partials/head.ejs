<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> | _baking_co</title><meta name="description" content="Discover _baking_co cakes for birthdays, anniversaries and your special moments. Enquire for delivery in Mohali, Kharar, Chandigarh and Panchkula."><meta name="theme-color" content="#5a3528"><link rel="icon" href="/favicon.svg"><link rel="stylesheet" href="/css/store.css"><script src="/js/store.js" type="module"></script></head><body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="announcement"><%= site.announcement %></div>
<header class="header"><div class="header-inner"><a class="wordmark" href="/" aria-label="Baking Co home"><span class="brand-name">baking<span class="brand-dot">.</span>co</span><small>MADE FOR YOUR MOMENTS</small></a><form class="search" action="/cakes"><input type="search" name="q" value="<%= query.q||'' %>" placeholder="Search for your perfect cake…" aria-label="Search cakes"><button aria-label="Search"><svg viewBox="0 0 24 24"><circle cx="10" cy="10" r="6"/><path d="m15 15 5 5"/></svg></button></form><a class="support" href="tel:+<%= site.whatsapp %>"><small>LET’S TALK CAKE</small><b>+<%= site.whatsapp %></b></a><a class="header-icon" href="/contact" aria-label="Contact and help"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 22v-2a8 8 0 0 1 16 0v2"/></svg></a><a class="header-icon bag-link" href="/cart" aria-label="Shopping bag"><svg viewBox="0 0 24 24"><path d="M4 7h16l1 15H3L4 7Zm4 0V5a4 4 0 0 1 8 0v2"/></svg><span id="bag-count">0</span></a></div></header>
<nav class="main-nav" aria-label="Main navigation"><div class="nav-inner"><a href="/cakes">All Cakes</a><div class="dropdown"><button aria-expanded="false">By Occasion <span>⌄</span></button><div class="dropdown-menu"><% [...new Set(cakes.map(c=>c.category))].forEach(category=>{ %><a href="/cakes?category=<%= encodeURIComponent(category) %>"><%= category %></a><% }) %><a href="/custom">Something special</a></div></div><div class="dropdown"><button aria-expanded="false">By Flavour <span>⌄</span></button><div class="dropdown-menu"><% [...new Set(cakes.flatMap(c=>c.flavours))].forEach(flavour=>{ %><a href="/cakes?flavour=<%= encodeURIComponent(flavour) %>"><%= flavour %></a><% }) %></div></div><a href="/custom">Designer Cakes</a><a href="/cakes?offers=1">Special Offers</a><a href="/corporate">Corporate Gifting</a><a href="/contact">Contact Us</a></div></nav>
