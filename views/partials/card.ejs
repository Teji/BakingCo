<article class="cake-card"><a class="cake-photo" href="/cakes/<%= cake.id %>"><img src="<%= imageUrl(cake.image) %>" alt="<%= cake.name %>" loading="lazy" width="600" height="600"><% if(cake.variants.some(v=>hasOffer(cake,v))){ %><span class="badge"><%= cake.offerText||'Special offer' %></span><% } %><span class="photo-arrow" aria-hidden="true">↗</span></a><div class="cake-card-info"><small><%= cake.category %><%= cake.sample?' · Sample inspiration':'' %></small><a href="/cakes/<%= cake.id %>"><h3><%= cake.name %></h3></a><p class="price"><%= startingPrice(cake)==null?'Quote on request':'From '+money(startingPrice(cake)) %></p><a class="card-choose" href="/cakes/<%= cake.id %>">Choose options <span>→</span></a></div></article>
