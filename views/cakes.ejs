<%- include('partials/head') %><main id="main" class="wrap section"><div class="breadcrumbs"><a href="/">Home</a> / Our cakes</div><div class="collection-heading"><div><p class="eyebrow">A LITTLE SLICE OF HAPPINESS</p><h1>Our cake collection</h1><p>Find a cake that feels like your celebration.</p></div><span><%= filtered.length %> cake<%= filtered.length===1?'':'s' %></span></div><form class="filters" action="/cakes"><input name="q" placeholder="Search cakes" value="<%= query.q||'' %>" aria-label="Search cake name"><select name="category" aria-label="Category"><option value="">All occasions</option><% [...new Set(cakes.map(c=>c.category))].forEach(c=>{ %><option <%= query.category===c?'selected':'' %>><%= c %></option><% }) %></select><select name="sort" aria-label="Sort"><option value="">Recommended</option><option value="low" <%= query.sort==='low'?'selected':'' %>>Price: low to high</option><option value="high" <%= query.sort==='high'?'selected':'' %>>Price: high to low</option><option value="name" <%= query.sort==='name'?'selected':'' %>>Name A–Z</option></select><% for(const key of ['flavour','weight','budget','offers']){if(query[key]){ %><input type="hidden" name="<%= key %>" value="<%= query[key] %>"><% }} %><button class="button dark">Apply filters</button><a class="text-link" href="/cakes">Reset</a></form><% if(query.flavour||query.weight||query.budget||query.offers){ %><p class="filter-note">Selected: <%= [query.flavour,query.weight,query.budget?'Under ₹'+query.budget:'',query.offers?'Special offers':''].filter(Boolean).join(' · ') %></p><% } %><div class="cake-grid"><% filtered.forEach(cake=>{ %><%- include('partials/card',{cake}) %><% }) %></div><% if(!filtered.length){ %><div class="empty"><h2>No cakes match just yet.</h2><p>Try another filter, or share your idea for a custom cake.</p><a class="button dark" href="/custom">Tell us your idea ↗</a></div><% } %></main><%- include('partials/footer') %>
