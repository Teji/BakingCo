<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Admin dashboard | _baking_co</title><link rel="stylesheet" href="/css/admin.css"><link rel="icon" href="/favicon.svg"></head><body class="admin-body">
<section id="login-card" class="admin-login-shell"><div class="admin-login-card"><div class="admin-brand-mark">b</div><p class="eyebrow">_baking_co · owner portal</p><h1>Welcome back</h1><p>Sign in to manage your live cake catalogue.</p><form id="login-form"><div class="field"><label>Email</label><input aria-label="Admin email" name="email" type="email" autocomplete="username" required></div><div class="field"><label>Password</label><input aria-label="Admin password" name="password" type="password" autocomplete="current-password" required></div><button class="admin-primary wide" type="submit">Sign in securely</button></form><button id="forgot-password" class="text-button" type="button">Forgot password?</button><p id="auth-status" role="status"></p><form id="reset-form" hidden><label>New password<input aria-label="Admin password" name="password" type="password" autocomplete="new-password" minlength="10" required></label><button class="admin-primary" type="submit">Save new password</button></form></div></section>
<div id="admin-app" class="admin-shell" hidden>
<aside class="admin-sidebar"><a class="admin-logo" href="/" target="_blank"><span>b</span><strong>_baking_co</strong></a><nav><button class="admin-nav active" data-view="dashboard">Dashboard</button><button class="admin-nav" data-view="cakes">Cakes <span id="nav-cake-count">0</span></button><button class="admin-nav" data-view="categories">Categories</button><button class="admin-nav" data-view="offers">Offers</button><button class="admin-nav" data-view="orders">Orders</button><button class="admin-nav" data-view="settings">Website settings</button></nav><div class="admin-side-bottom"><a href="/" target="_blank" class="admin-site-link">View storefront ↗</a><button id="logout" class="admin-logout">Log out</button></div></aside>
<main class="admin-main"><header class="admin-topbar"><div><p class="eyebrow">LIVE STORE MANAGEMENT</p><h1 id="view-title">Dashboard</h1></div><div class="admin-top-actions"><span class="live-pill">● Live · Node v12</span><button id="export-catalog" class="admin-secondary">Export cakes JSON</button><button id="reload" class="admin-secondary">↻ Refresh</button><button id="new-cake" class="admin-primary">+ Add cake</button></div></header><p id="editor-status" class="admin-status" role="status" aria-live="polite"></p>
<section id="dashboard-view" class="admin-view"></section>
<section id="cakes-view" class="admin-view" hidden><div class="admin-card"><div class="catalog-head"><div><h2>Cake catalogue</h2><p>Search, filter and manage every cake shown on your store.</p></div><div class="catalog-tools"><input id="cake-search" type="search" placeholder="Search cakes…"><select id="cake-filter"><option value="all">All status</option><option value="visible">Visible</option><option value="hidden">Hidden</option><option value="available">Available</option><option value="soldout">Sold out</option><option value="featured">Featured</option></select></div></div><div id="cake-list" class="cake-admin-grid"></div></div></section>
<section id="categories-view" class="admin-view" hidden></section><section id="offers-view" class="admin-view" hidden></section><section id="orders-view" class="admin-view" hidden></section><section id="settings-view" class="admin-view" hidden><div id="settings-content"></div></section>
</main></div>
<div id="editor-modal" class="admin-modal" hidden><div class="admin-modal-backdrop" data-close-editor></div><section class="admin-editor-drawer" role="dialog" aria-modal="true" aria-labelledby="editor-heading"><header><div><p class="eyebrow">PRODUCT EDITOR</p><h2 id="editor-heading">Cake</h2></div><button class="icon-close" data-close-editor aria-label="Close">×</button></header><div id="editor-form" class="admin-editor-content"></div><footer><button class="admin-secondary" data-close-editor>Cancel</button><button id="delete-cake" class="admin-danger" type="button">Delete</button><button id="save-live" class="admin-primary" type="button">Save changes</button></footer></section></div>
<script type="module" src="/js/admin-bundle.js"></script></body></html>
